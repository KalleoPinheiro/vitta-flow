# Banco PostgreSQL (obrigatório fora do docker compose — o compose já injeta)
DATABASE_URL=postgres://vitta:vitta@localhost:5432/vitta

# Pool de conexões (opcionais — padrões entre parênteses)
# PG_POOL_MAX=10               # conexões simultâneas por instância (10)
# PG_CONNECT_TIMEOUT_MS=5000   # espera por conexão livre no pool (5s)
# PG_IDLE_TIMEOUT_MS=30000     # fecha conexão ociosa (30s)
# PG_STATEMENT_TIMEOUT_MS=15000 # aborta query longa (15s)

# Migrações: por padrão rodam no boot com advisory lock (seguro com réplicas).
# Em deploys com step dedicado, rode `npm run db:migrate` e desligue o boot-migrate:
# VITTA_MIGRATE_ON_BOOT=false

# Fuso horário da clínica (horário comercial é validado em hora local)
TZ=America/Sao_Paulo

# Autenticação (OBRIGATÓRIO em produção — sem estas variáveis o sistema responde 503)
# Em desenvolvimento (NODE_ENV != production) podem ficar vazias: sistema roda aberto com aviso.
AUTH_PASSWORD=troque-esta-senha
# Gere com: openssl rand -hex 32
AUTH_SECRET=

# ── Login com Google (OAuth) — opcional ─────────────────────────────────────
# Habilita "Entrar com Google" e usa o calendário da conta logada para a agenda.
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# 2. Authorized redirect URI: {APP_URL}/api/auth/google/callback
# 3. Habilite a Google Calendar API no projeto.
# URL pública da aplicação (usada no redirect do OAuth):
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowlist OBRIGATÓRIA (separada por vírgula) — sem ela o login Google fica desativado:
GOOGLE_ALLOWED_EMAILS=

# ── Google Calendar via service account — alternativa sem login Google ──────
# Usada apenas quando nenhuma conta Google está conectada via OAuth.
# Compartilhe o calendário com o email da service account (permissão "Fazer alterações").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Com OAuth: destino dos eventos (padrão "primary" = calendário da conta logada).
# Com service account: id do calendário compartilhado (obrigatório nesse modo).
GOOGLE_CALENDAR_ID=

# ── Fotos de evolução (F6) ──────────────────────────────────────────────────
# Diretório dos arquivos de foto (fora do public/; monte um volume no Docker).
# UPLOADS_DIR=./uploads

# ── Documentos clínicos (F7) — cabeçalho/assinatura ─────────────────────────
# CLINIC_NAME=VittaFlow — Clínica de Estomaterapia
# CLINIC_CNPJ=
# CLINIC_ADDRESS=
# CLINIC_CITY=
# CLINIC_PROFESSIONAL_NAME=
# CLINIC_PROFESSIONAL_REGISTRY=COREN-SP 000000

# ── Lembretes por WhatsApp (F8) — opcional ──────────────────────────────────
# Sem credenciais o job roda em dry-run (loga o que enviaria, não envia).
# Meta Cloud API: Business Manager → WhatsApp → API Setup
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Segredo do disparo externo (cron): POST /api/reminders/run com header x-cron-secret
# Gere com: openssl rand -hex 24
# CRON_SECRET=

# ── Suíte E2E (Playwright) — opcional ───────────────────────────────────────
# Por padrão a suíte gera estes valores a cada execução e os propaga aos workers e ao
# servidor que ela mesma sobe (ver e2e/support/constants.ts) — não é preciso definir nada.
#
# Só defina para reaproveitar um `npm run dev` iniciado à parte. Nesse caso o
# webServer.env do Playwright não é aplicado, então os DOIS pares precisam bater:
# E2E_AUTH_* para a suíte e AUTH_* (com os mesmos valores) para o servidor.
# E2E_AUTH_SECRET=
# E2E_AUTH_PASSWORD=

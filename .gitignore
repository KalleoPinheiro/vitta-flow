# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-open-mode/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database
/data

# .env.example é modelo, deve ser versionado
!.env.example

# Fotos de evolução (dados sensíveis de pacientes — nunca versionar)
uploads/

# Playwright E2E
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/.auth/
/e2e/support/seed-data.json
